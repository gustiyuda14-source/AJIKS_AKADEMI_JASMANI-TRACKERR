{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": [
    "DATABASE_URL",
    "JWT_SECRET",
    "NODE_ENV",
    "FRONTEND_URL"
  ],
  "functions": {
    "api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
